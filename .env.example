# ============================================================
# ASS AL HALAAL / KABSH NAJD - ENVIRONMENT TEMPLATE
# Safe to commit. Do NOT put real secrets in this file.
# Copy this file to .env locally and fill in private values there.
# ============================================================

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=5173

# Optional custom SQLite path. Leave blank to use ./data/kabsh-najd.sqlite3
KABSH_DB_PATH=

# Set to 1 only when the app is behind a trusted reverse proxy
# that correctly sets X-Forwarded-For. Render production should use 1.
KABSH_TRUST_PROXY=0

# Canonical public origin used by the explicit CORS/origin policy.
# Production example:
# KABSH_PUBLIC_ORIGIN=https://ass-al-halaal.onrender.com
KABSH_PUBLIC_ORIGIN=

# Production defaults to HTTPS-only. Set to 0 only for controlled diagnostics.
KABSH_ENFORCE_HTTPS=1

# Localhost: 0
# Production HTTPS: NODE_ENV=production already forces secure cookies.
KABSH_COOKIE_SECURE=0

# 1-30 days
KABSH_CUSTOMER_SESSION_DAYS=30

# Optional abuse-triggered CAPTCHA for repeated customer login/registration attempts.
# Supported provider: Cloudflare Turnstile.
# Leave blank to keep CAPTCHA disabled while rate limiting remains active.
KABSH_CAPTCHA_PROVIDER=
KABSH_CAPTCHA_SECRET=

# ------------------------------------------------------------
# Default Admin / Authentication
# ------------------------------------------------------------
KABSH_DEFAULT_ADMIN_USER_ID=ADM-JED-001

# Real values belong only in .env, never in source control.
KABSH_ADMIN_EMAIL=
KABSH_ADMIN_PHONE=
KABSH_ADMIN_BOOTSTRAP_PASSWORD=

# Use 1 only when intentionally resetting the bootstrap admin password.
# Return it to 0 after the reset.
KABSH_RESET_ADMIN_PASSWORD=0

# 1-24 hours
KABSH_ADMIN_SESSION_HOURS=8

# OTP policy
KABSH_ADMIN_OTP_MINUTES=5
KABSH_ADMIN_OTP_MAX_ATTEMPTS=5
KABSH_ADMIN_OTP_RESEND_SECONDS=45
KABSH_ADMIN_OTP_MAX_RESENDS=3

# Required in production. Generate a long random secret.
KABSH_OTP_PEPPER=

# ------------------------------------------------------------
# Email OTP - Resend
# ------------------------------------------------------------
RESEND_API_KEY=
KABSH_OTP_FROM_EMAIL=

# Example after verifying your domain:
# KABSH_OTP_FROM_EMAIL=Ass Al Halaal Security <no-reply@yourdomain.com>

# ------------------------------------------------------------
# SMS OTP - Twilio
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------
# Google Customer Sign-In
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# WhatsApp / Meta Cloud API
# ------------------------------------------------------------
WHATSAPP_ENABLED=0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# ------------------------------------------------------------
# Optional Hosted AI Providers
# Current AI service works locally without these keys.
# Keep blank unless a hosted provider is added/used.
# ------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
